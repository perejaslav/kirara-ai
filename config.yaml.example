# Пример конфигурации Kirara RU
# Скопируйте этот файл в config.yaml (или data/config.yaml) и заполните своими данными.

# --- Мессенджеры ---
# Рекомендуемый способ подключения — Telegram. Остальные адаптеры можно добавить по аналогии.
ims:
  - name: "telegram-основной"
    enable: true
    adapter: "telegram"          # telegram | qqbot | wecom | http_legacy ...
    config:
      token: "123456:ABCDEF..."  # токен бота от @BotFather

  # Пример QQ (необязательно):
  # - name: "qq-бот"
  #   enable: false
  #   adapter: "qqbot"
  #   config:
  #     qq: "123456"
  #     token: "your-qq-token"

# --- Плагины ---
plugins:
  enable: []                     # список включённых внешних плагинов (пусто = только встроенные)

# --- Веб-панель ---
web:
  host: "127.0.0.1"              # адрес прослушивания (0.0.0.0 — доступен извне)
  port: 8080                     # порт веб-панели
  secret_key: "замените-на-случайный-секретный-ключ"  # замените на случайную строку

# --- Модели (LLM) ---
# Поддерживаются любые OpenAI-совместимые API: OpenAI, DeepSeek, LM Studio, Ollama, llama.cpp, vLLM и т.д.
llms:
  api_backends:

    # Пример: OpenAI
    - name: "openai"
      adapter: "openai"
      enable: true
      config:
        api_key: "sk-..."                       # API-ключ
        api_base: "https://api.openai.com/v1"  # базовый URL API
      models:
        - "gpt-4o-mini"
        - "gpt-4o"

    # Пример: DeepSeek
    - name: "deepseek"
      adapter: "deepseek"
      enable: false
      config:
        api_key: "sk-..."
        api_base: "https://api.deepseek.com/v1"
      models:
        - "deepseek-chat"
        - "deepseek-reasoner"

    # Пример: локальный OpenAI-совместимый бэкенд (LM Studio / Ollama / llama.cpp / vLLM)
    - name: "локальная-модель"
      adapter: "openai"
      enable: false
      config:
        api_key: "lm-studio"                    # для локальных бэкендов ключ может быть любым
        api_base: "http://localhost:1234/v1"    # LM Studio: 1234, Ollama: 11434, llama.cpp: 8080
      models:
        - "local-model"

# --- Модель по умолчанию ---
defaults:
  llm_model: gpt-4o-mini

# --- Память ---
memory:
  persistence:
    type: file                   # file или redis
    file:
      storage_dir: ./data/memory
    redis:
      host: localhost
      port: 6379
      db: 0
  max_entries: 100               # максимум записей на область
  default_scope: member          # member | group | global

# --- Система ---
system:
  timezone: Europe/Moscow        # часовой пояс

# --- Источники обновлений ---
update:
  pypi_registry: https://pypi.org/simple
  npm_registry: https://registry.npmjs.org

# --- Трассировка (отладка) ---
tracing:
  llm_tracing_content: false     # записывать ли содержимое запросов к LLM
